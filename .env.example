# Frontend → our Supabase backend. Copy to `.env` and fill in to run against a live
# project; leave unset to run the prototype entirely on in-memory seed data.
#
# These are the PUBLIC anon values only (RLS-guarded). Never put the service-role key or
# any secret in a VITE_ variable — anything VITE_-prefixed is shipped to the browser.
VITE_SUPABASE_URL=https://<your-project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<your-anon-key>
